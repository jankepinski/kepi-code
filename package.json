{
  "name": "kepi-code",
  "version": "0.1.0",
  "description": "Ultra-lightweight coding agent powered by OpenRouter. One tool: bash.",
  "type": "module",
  "bin": {
    "kepi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/builtin-skills"
  ],
  "preferGlobal": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "openrouter",
    "coding-agent",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^0.4.5",
    "ai": "^4.3.16",
    "commander": "^14.0.3",
    "execa": "^9.5.2",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.7",
    "marked-terminal": "^7.2.1",
    "react": "^19.2.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
